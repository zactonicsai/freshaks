# shellcheck shell=bash
# ============================================================================
#  config.env - every setting of the demo lives here.
#  Each line keeps a value you already exported, so you can override one
#  setting for one run:   HOST_HTTPS_PORT=9443 scripts/01-create-cluster.sh
# ============================================================================

# ---- names ----------------------------------------------------------------
CLUSTER_NAME="${CLUSTER_NAME:-fipsdemo}"            # kind cluster name
APP_NS="${APP_NS:-fipsdemo}"                        # namespace of the Java app
INGRESS_NS="${INGRESS_NS:-istio-ingress}"           # namespace of the Istio ingress gateway
ISTIO_NS="${ISTIO_NS:-istio-system}"                # namespace of the Istio control plane

# ---- versions (checked October 2026) ---------------------------------------
# Istio 1.31 supports Kubernetes 1.32-1.36, so we pin 1.36 (kind's default is already 1.37).
KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed}"
ISTIO_VERSION="${ISTIO_VERSION:-1.31.1}"
IPA_IMAGE="${IPA_IMAGE:-quay.io/freeipa/freeipa-server:almalinux-9}"
BUILDER_IMAGE="${BUILDER_IMAGE:-registry.access.redhat.com/ubi9/openjdk-25}"
RUNTIME_IMAGE="${RUNTIME_IMAGE:-registry.access.redhat.com/ubi9/openjdk-25-runtime}"

# ---- FreeIPA (the domain controller) ---------------------------------------
IPA_DOMAIN="${IPA_DOMAIN:-fipsdemo.test}"           # ".test" is reserved for testing, it can never clash
IPA_REALM="${IPA_REALM:-FIPSDEMO.TEST}"             # Kerberos realm = domain in CAPITALS
IPA_HOSTNAME="${IPA_HOSTNAME:-ipa.fipsdemo.test}"
IPA_CONTAINER="${IPA_CONTAINER:-fipsdemo-ipa}"
IPA_VOLUME="${IPA_VOLUME:-fipsdemo-ipa-data}"
IPA_DOCKER_EXTRA_OPTS="${IPA_DOCKER_EXTRA_OPTS:-auto}"   # "auto" picks cgroup flags for your Docker; or write your own flags

# ---- demo passwords: CHANGE THEM for anything that is not a toy ------------
IPA_ADMIN_PASSWORD="${IPA_ADMIN_PASSWORD:-Admin-Demo-Passw0rd}"
DEMO_USER="${DEMO_USER:-alice}"
DEMO_USER_PASSWORD="${DEMO_USER_PASSWORD:-Alice-Demo-Passw0rd}"

# ---- the web app ------------------------------------------------------------
APP_HOSTNAME="${APP_HOSTNAME:-app.fipsdemo.test}"   # name in the TLS certificate
CLIENT_HOSTNAME="${CLIENT_HOSTNAME:-tester.fipsdemo.test}"   # name in the client certificate (mutual TLS test)
HOST_HTTPS_PORT="${HOST_HTTPS_PORT:-8443}"          # https://app.fipsdemo.test:8443 on your computer
NODEPORT_HTTPS="${NODEPORT_HTTPS:-30443}"
APP_IMAGE_NONFIPS="${APP_IMAGE_NONFIPS:-fipsdemo-app:1.0-nonfips}"
APP_IMAGE_FIPS="${APP_IMAGE_FIPS:-fipsdemo-app:2.0-fips}"
APP_REPLICAS="${APP_REPLICAS:-2}"

# ---- node pools -------------------------------------------------------------
# label "key=value" that picks the nodes for the old (blue) and the new FIPS (green) pods.
# On a real cloud use that cloud's own label, e.g. AKS: kubernetes.azure.com/fips_enabled=true
BLUE_NODE_SELECTOR="${BLUE_NODE_SELECTOR:-nodepool=blue}"
GREEN_NODE_SELECTOR="${GREEN_NODE_SELECTOR:-nodepool=green}"

# ---- FIPS settings ----------------------------------------------------------
# Istio TLS rule set. fips-140-3 is new in Istio 1.31 (TLS 1.2+1.3). Older choice: fips-140-2 (TLS 1.2 only).
ISTIO_COMPLIANCE_POLICY="${ISTIO_COMPLIANCE_POLICY:-fips-140-3}"
# true  = REAL upgrade: stop unless every green node has a kernel booted with fips=1
# false = PRACTICE mode: go on and print a big warning (a laptop kernel is not in FIPS mode)
REQUIRE_KERNEL_FIPS="${REQUIRE_KERNEL_FIPS:-false}"
TLS_KEY_BITS_NONFIPS="${TLS_KEY_BITS_NONFIPS:-2048}"
TLS_KEY_BITS_FIPS="${TLS_KEY_BITS_FIPS:-3072}"

# ---- safety -----------------------------------------------------------------
AUTO_ROLLBACK="${AUTO_ROLLBACK:-true}"              # upgrade script undoes itself when a check fails
ROLLOUT_TIMEOUT="${ROLLOUT_TIMEOUT:-300s}"
