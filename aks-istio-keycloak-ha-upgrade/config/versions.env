# shellcheck shell=bash
# shellcheck disable=SC2034
# =============================================================================
# config/versions.env — every version number used by the scripts lives here.
# "OLD" is what the install scripts deploy; the upgrade scripts walk to "NEW".
# Versions were checked against the upstream release pages on 2 October 2026.
# Each line uses  : "${NAME:=value}"  which means "keep NAME if it is already
# set in the environment, otherwise use this default".
# =============================================================================

# --- Kubernetes (AKS) --------------------------------------------------------
# Oldest minor that AKS still lets you create today (leaves support Nov 2026).
: "${K8S_VERSION_OLD:=1.34}"
# AKS upgrades the control plane one minor at a time, so list every stop.
: "${K8S_UPGRADE_PATH:=1.35 1.36}"

# --- Istio -------------------------------------------------------------------
# 1.28 is the oldest Istio line that officially supports Kubernetes 1.34.
: "${ISTIO_VERSION_OLD:=1.28.1}"
# Istio also moves one minor at a time; each stop is the latest patch of its line.
: "${ISTIO_UPGRADE_PATH:=1.29.8 1.30.5 1.31.1}"
# Helm repository that hosts the Istio charts (older docs use
# https://istio-release.storage.googleapis.com/charts — both serve the same charts).
: "${ISTIO_HELM_REPO:=https://blob.istio.io/istio-release/charts}"

# --- Keycloak ----------------------------------------------------------------
# Old line: still uses the "hostname v1" and KC_PROXY settings.
: "${KEYCLOAK_VERSION_OLD:=24.0.5}"
# Newest release. It came out one day before this was written; if you prefer a
# release that has had more time in the field, use 26.7.5 instead.
: "${KEYCLOAK_VERSION_NEW:=26.8.0}"

# --- PostgreSQL --------------------------------------------------------------
# PostgreSQL 14 leaves support in November 2026.
: "${POSTGRES_VERSION_OLD:=14.12}"
# Newest stable major (19 is still in beta).
: "${POSTGRES_VERSION_NEW:=18.6}"

# --- NFS server pod ----------------------------------------------------------
# Chart "nfs-server-provisioner" from kubernetes-sigs (runs NFS-Ganesha 4.0.8).
: "${NFS_CHART_VERSION:=1.8.0}"
# Helm repository of that chart.
: "${NFS_HELM_REPO:=https://kubernetes-sigs.github.io/nfs-ganesha-server-and-external-provisioner/}"

# --- The two demo applications -----------------------------------------------
# Image tag built and deployed by the install scripts.
: "${APP_VERSION_OLD:=1.0.0}"
# Image tag built and rolled out by the upgrade scripts.
: "${APP_VERSION_NEW:=2.0.0}"
