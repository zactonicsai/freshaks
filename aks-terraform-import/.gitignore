# Local configuration (contains subscription IDs, namespace lists ...)
config.env

# Everything the scripts produce: kubeconfig, inventories, plan logs, backups
out/

# Terraform working files and state (state can contain secrets!)
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/terraform.tfvars
terraform/crash.log

# Helm values pulled from the cluster may contain credentials
terraform/helm-values/
