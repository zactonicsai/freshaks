{
  "apiVersion": "networking.istio.io/v1",
  "kind": "Sidecar",
  "metadata": {
    "labels": {
      "app.kubernetes.io/part-of": "fipsdemo"
    },
    "name": "default",
    "namespace": "fipsdemo"
  },
  "spec": {
    "egress": [
      {
        "hosts": [
          "./*",
          "istio-system/*"
        ]
      }
    ],
    "outboundTrafficPolicy": {
      "mode": "REGISTRY_ONLY"
    }
  }
}
