{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "labels": {
      "app.kubernetes.io/part-of": "fipsdemo"
    },
    "name": "istio-ingressgateway",
    "namespace": "istio-ingress"
  },
  "spec": {
    "externalTrafficPolicy": "Cluster",
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "https",
        "nodePort": 30443,
        "port": 443,
        "protocol": "TCP",
        "targetPort": 443
      }
    ],
    "selector": {
      "istio": "ingressgateway"
    },
    "sessionAffinity": "None",
    "type": "NodePort"
  }
}
