# Created by the scripts: remembered versions, passwords, certificates,
# kubeconfig files, backups.
.state/
# Settings for docker compose, written by the scripts (contains the cluster token).
.env
# Log files of every script run.
logs/

# Java build output (only when you build outside Docker).
apps/*/target/

# Editor and OS files.
.idea/
.vscode/
.DS_Store
