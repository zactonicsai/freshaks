# Copy to repo-secret.yaml if you apply credentials by hand.
apiVersion: v1
kind: Secret
metadata:
  name: gitea-demo-gitops
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: http://gitea.gitea.svc.cluster.local:3000/gitea_admin/demo-gitops.git
  username: gitea_admin
  password: LabPass123!
  insecure: "true"
