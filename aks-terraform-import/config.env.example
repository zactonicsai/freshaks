# =============================================================================
#  config.env — settings shared by every script (copy to config.env and edit)
# =============================================================================
#  Only the first three values are required. Everything else has a sensible
#  default (shown here) and can also be overridden per-run on the command
#  line, e.g.   DRY_RUN=true ./destroy/04-destroy-networking.sh
# =============================================================================

# --- Required ----------------------------------------------------------------
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=rg-aks-prod            # resource group that holds the AKS cluster
CLUSTER_NAME=aks-prod                 # name of the managed cluster

# --- Azure scope -------------------------------------------------------------
# NODE_RESOURCE_GROUP=MC_rg-aks-prod_aks-prod_eastus   # auto-detected from `az aks show`
# LOCATION=eastus                                      # auto-detected from `az group show`

# Also scan / destroy objects inside the AKS node resource group (MC_*).
# AKS creates and reconciles those itself (VMSS, "kubernetes" load balancer,
# outbound public IPs, agent-pool NSG, route table, PVC disks). Importing them
# usually causes permanent plan drift and deleting them can break the cluster.
# Leave false unless you know you need it; deleting the cluster removes the
# whole node resource group anyway.
INCLUDE_NODE_RG=false

# --- Kubernetes access -------------------------------------------------------
# Where `az aks get-credentials` writes the kubeconfig the scripts and the
# Terraform kubernetes/helm providers use.
# KUBECONFIG_PATH=./out/kubeconfig
# Use the cluster-admin credential instead of your Entra ID identity.
USE_ADMIN_CREDENTIALS=false

# Namespaces that belong to AKS / the platform. Never imported, never deleted.
# SYSTEM_NAMESPACES="kube-system kube-public kube-node-lease gatekeeper-system calico-system tigera-operator aks-istio-system aks-istio-ingress aks-istio-egress aks-command app-routing-system azure-arc azure-arc-release dapr-system kube-federation-system"

# Restrict the Kubernetes/Helm scripts to these namespaces (space separated).
# Blank = every namespace that is not a system namespace.
# K8S_NAMESPACES="default app-a app-b"

# --- What to import ----------------------------------------------------------
# kubernetes_secret_v1: the secret DATA is written into generated HCL and into
# the Terraform state file. Keep false unless your state backend is encrypted
# and access-controlled.
IMPORT_SECRETS=false
# azurerm_key_vault_secret: same caveat (secret values end up in state).
IMPORT_KEYVAULT_SECRETS=false
# azurerm_storage_share for Azure Files shares (data-plane objects).
IMPORT_FILE_SHARES=false

# Helm releases to leave alone, as "namespace/release" pairs.
# HELM_SKIP_RELEASES="monitoring/kube-prometheus-stack"
# Helm does not record where a chart came from. Pre-seed repositories here as
# "chart=url" pairs so the generated helm_release blocks are complete.
# HELM_REPO_MAP="ingress-nginx=https://kubernetes.github.io/ingress-nginx cert-manager=https://charts.jetstack.io"

# Container registries that live outside RESOURCE_GROUP but belong to this
# platform (registries attached to the cluster are auto-detected too).
# ACR_NAMES="myregistry otherregistry"

# --- Behaviour ---------------------------------------------------------------
# Print every az / kubectl / helm / terraform command instead of running it.
DRY_RUN=false
# Write import blocks only; do not run `terraform plan -generate-config-out`.
SKIP_GENERATE=false
