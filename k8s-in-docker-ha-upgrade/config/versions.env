# shellcheck shell=bash
# shellcheck disable=SC2034
# =============================================================================
# config/versions.env — every version number used by the scripts lives here.
# "OLD" is what the install scripts deploy; the upgrade scripts walk to "NEW".
# Versions were checked against the upstream release pages on 4 October 2026.
# Each line uses  : "${NAME:=value}"  which means "keep NAME if it is already
# set in the environment, otherwise use this default".
# =============================================================================

# --- Kubernetes (K3s, a small certified Kubernetes that runs well in Docker) --
# Image that contains K3s; one container of it is one Kubernetes node.
: "${K3S_IMAGE:=rancher/k3s}"
# Old version = image tag. (K3s versions look like v1.34.12+k3s1; image tags
# cannot contain "+", so the tag uses "-" instead.)
: "${K8S_VERSION_OLD:=v1.34.12-k3s1}"
# Kubernetes is upgraded one minor version at a time, so list every stop.
# Kubernetes 1.37 exists already, but Istio 1.31 does not support it yet -
# "newest" is not always the right target.
: "${K8S_UPGRADE_PATH:=v1.35.9-k3s1 v1.36.5-k3s1}"

# --- Istio -------------------------------------------------------------------
# 1.28 is the oldest Istio line that officially supports Kubernetes 1.34.
: "${ISTIO_VERSION_OLD:=1.28.1}"
# Istio also moves one minor at a time; each stop is the latest patch of its line.
: "${ISTIO_UPGRADE_PATH:=1.29.8 1.30.5 1.31.1}"
# Helm repository that hosts the Istio charts.
: "${ISTIO_HELM_REPO:=https://blob.istio.io/istio-release/charts}"

# --- Keycloak ----------------------------------------------------------------
# Old line: still uses the "hostname v1" and KC_PROXY settings.
: "${KEYCLOAK_VERSION_OLD:=24.0.5}"
# Newest release. It is only days old; if you prefer a release that has had
# more time in the field, use 26.7.5 instead.
: "${KEYCLOAK_VERSION_NEW:=26.8.0}"

# --- PostgreSQL --------------------------------------------------------------
# PostgreSQL 14 leaves support in November 2026.
: "${POSTGRES_VERSION_OLD:=14.12}"
# Newest stable major (19 is still in beta).
: "${POSTGRES_VERSION_NEW:=18.6}"

# --- NFS server pod ----------------------------------------------------------
# Chart "nfs-server-provisioner" from kubernetes-sigs (runs NFS-Ganesha 6.5).
: "${NFS_CHART_VERSION:=1.8.0}"
# Helm repository of that chart.
: "${NFS_HELM_REPO:=https://kubernetes-sigs.github.io/nfs-ganesha-server-and-external-provisioner/}"

# --- The demo application (one image, deployed twice: app1 and app2) ---------
# Image tag built and deployed by the install scripts.
: "${APP_VERSION_OLD:=1.0.0}"
# Image tag built and rolled out by the upgrade scripts.
: "${APP_VERSION_NEW:=2.0.0}"

# --- Tools container (kubectl and helm run inside it, not on your machine) ----
# kubectl may be one minor version away from the cluster, so 1.35 fits 1.34-1.36.
: "${KUBECTL_VERSION:=v1.35.9}"
# Helm 4 (a release that has already had patch releases).
: "${HELM_VERSION:=v4.2.4}"

# --- Helper containers -------------------------------------------------------
# Load balancer in front of the Kubernetes nodes (3.2 is a long-term-support line).
: "${HAPROXY_IMAGE:=haproxy:3.2}"
# Image registry: one copy stores the application image, a second copy is a
# cache in front of Docker Hub.
: "${REGISTRY_IMAGE:=registry:3}"
