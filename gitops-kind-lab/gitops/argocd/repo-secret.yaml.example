# Copy to repo-secret.yaml and fill in. Do not commit real tokens.
apiVersion: v1
kind: Secret
metadata:
  name: bitbucket-demo-gitops
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: http://bitbucket.scm.svc.cluster.local:7990/scm/DEMO/demo-gitops.git
  username: admin
  password: REPLACE_WITH_HTTP_ACCESS_TOKEN
  insecure: "true"
