{
  "realm": "demo",
  "enabled": true,
  "displayName": "Demo Realm",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "groups": [
    { "name": "managers" }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Manager",
      "groups": ["/managers"],
      "credentials": [{ "type": "password", "value": "__ALICE_PASSWORD__", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Manager",
      "groups": ["/managers"],
      "credentials": [{ "type": "password", "value": "__BOB_PASSWORD__", "temporary": false }]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Member",
      "groups": [],
      "credentials": [{ "type": "password", "value": "__CAROL_PASSWORD__", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "demo-app",
      "name": "Demo Java App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__OIDC_CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://__APP_HOST__",
      "baseUrl": "/",
      "redirectUris": ["https://__APP_HOST__/login/oauth2/code/keycloak"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://__APP_HOST__/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
