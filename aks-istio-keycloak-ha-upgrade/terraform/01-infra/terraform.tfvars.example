# Copy to terraform.tfvars and adjust. Everything has a default; the lines
# below are the ones you change during an upgrade.

# subscription_id = "00000000-0000-0000-0000-000000000000"

# --- Kubernetes upgrade, one minor version at a time -------------------------
# Step 1: raise the control plane, keep the nodes:
#   kubernetes_version           = "1.35"
#   node_pool_kubernetes_version = "1.34"
# Step 2: raise the nodes (they roll one by one with surge):
#   node_pool_kubernetes_version = "1.35"
# Then repeat both steps for 1.36.
kubernetes_version           = "1.34"
node_pool_kubernetes_version = "1.34"

# --- Blue/green alternative for the workload nodes ---------------------------
# Step 2a: add a second pool with the new version, apply:
#   user_node_pools = {
#     apps  = { kubernetes_version = "1.34" }
#     appsb = { kubernetes_version = "1.35" }
#   }
# Step 2b: cordon and drain the old pool with kubectl, check the apps, then
# remove the "apps" line and apply again.
user_node_pools = {
  apps = {}
}
